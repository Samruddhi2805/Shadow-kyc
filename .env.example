# Shadow-KYC / ZK-AML Environment Variables Example
# Copy this file to .env and configure for your environment.

# ─── Active Network ─────────────────────────────────────────────────────────
# Specify the network to connect to: 'undeployed', 'preview', or 'preprod'.
NETWORK=preprod
VITE_NETWORK=preprod

# ─── Contract Address ───────────────────────────────────────────────────────
# Verified Midnight Preprod Deployed Address (64 hex chars):
CONTRACT_ADDRESS=1387bebdf07d4f8d5d9cc5d5f8e1e27db2a3a37e3b144daf4ec2413d5374abc0
VITE_CONTRACT_ADDRESS=1387bebdf07d4f8d5d9cc5d5f8e1e27db2a3a37e3b144daf4ec2413d5374abc0

# ─── Frontend API Endpoint (Vercel) ─────────────────────────────────────────
# Permanent HTTPS backend API URL for the Vercel frontend.
# Set this in your Vercel Project Settings > Environment Variables.
# Example: https://shadow-kyc-api.yourdomain.com/api
# Leave blank for local development (Vite proxies /api to http://127.0.0.1:8080).
VITE_API_BASE_URL=

# ─── Prover Server (Optional override) ──────────────────────────────────────
# Prover server URL. Defaults to {VITE_API_BASE_URL}/prover via backend proxy.
# VITE_PROVER_URL=

# ─── Backend Service URLs (Optional overrides) ──────────────────────────────
# When running on Docker / VPS, the API server connects to these Midnight endpoints:
# MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# ─── API Server ─────────────────────────────────────────────────────────────
# PORT=8080